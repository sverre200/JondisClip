{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JondisClip",
  "version": "0.1.0",
  "identifier": "com.jondisclip.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "JondisClip",
        "width": 820,
        "height": 720,
        "minWidth": 640,
        "minHeight": 520,
        "theme": "Dark",
        "backgroundColor": "#121316",
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
